---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import BrandMark from "../components/BrandMark.astro";
import LevelIcon from "../components/LevelIcon.astro";
import Sources from "../components/Sources.astro";
import Stamp from "../components/Stamp.astro";
import dashboard from "../assets/dashboard.png";
import { changelog, facts, faq, firstPublished, lastVerified, methodology, prepare, sources, status, timeline, type Level } from "../data/reforme";
import { href, kindLabel, levelLabel, formatDate, titleMonth, url } from "../lib";
import { issues, repo, siteName } from "../../site.config";

const h1 = "Facturation électronique au Maroc : où en est la réforme ?";
const verified = formatDate(lastVerified);
const title = `${h1} (${titleMonth(lastVerified)})`;
const description = `${status.headline}. Dernière vérification : ${verified}. Faits classés par niveau de certitude, avec leurs sources.`;
const image = url("og.png");

const levels: Level[] = ["en-vigueur", "annonce", "non-confirme"];
const groups: Record<Level, string> = {
  "en-vigueur": "Ce qui est dans la loi",
  annonce: "Ce qui a été annoncé",
  "non-confirme": "Ce qui circule sans être confirmé",
};
const legend: Record<Level, string> = {
  "en-vigueur": "Figure dans un texte officiel publié.",
  annonce: "Déclaré par l'administration ou rapporté par la presse, sans texte publié qui le fixe.",
  "non-confirme": "Circule en ligne sans texte officiel ni source officielle.",
};
const events = [...timeline].sort((a, b) => a.date.localeCompare(b.date));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: h1,
    description,
    datePublished: firstPublished,
    dateModified: lastVerified,
    inLanguage: "fr",
    mainEntityOfPage: { "@type": "WebPage", "@id": url() },
    image: image,
    author: { "@type": "Organization", name: siteName, url: repo },
    publisher: { "@type": "Organization", name: siteName, url: repo },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "fr",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [{ "@type": "ListItem", position: 1, name: h1, item: url() }],
  },
];
---

<Base title={title} description={description} image={image} jsonLd={jsonLd}>
  <div class="band">
    <header class="site-header">
      <a class="brand" href={href()} aria-label="Tabaa, accueil">
        <BrandMark size={28} />
        <span class="brand-word">Tabaa</span>
      </a>
      <nav aria-label="Liens"><a href={repo} rel="noopener">Le logiciel</a></nav>
    </header>
  </div>

  <main id="contenu">
    <div class="band hero">
      <div class="hero-text">
        <h1>{h1}</h1>
        <p class="verdict">{status.headline}</p>
        <p class="lede">{status.summary}</p>
        <p class="verified">
          <span>Dernière vérification :</span>
          <time class="mono" datetime={lastVerified}>{verified}</time>
        </p>
      </div>
      <div class="hero-stamp">
        <Stamp word={status.stamp.word} ring={status.stamp.ring} city={status.stamp.city} date={lastVerified.split("-").reverse().join("/")} idPrefix="hero" />
      </div>
    </div>

    <section class="sec col" aria-labelledby="basis">
      <div class="sec-inner">
        <h2 id="basis">Sur quoi repose ce constat</h2>
        <ul class="basis">
          {status.basis.map((b) => (
            <li>
              <p>{b.text}</p>
              <Sources ids={b.sources} />
            </li>
          ))}
        </ul>
        <aside class="limits" aria-labelledby="limits-title">
          <h3 id="limits-title">Limites de ce constat</h3>
          <p>{status.limits}</p>
        </aside>
      </div>
    </section>

    <section class="sec col" aria-labelledby="niveaux">
      <div class="sec-inner">
        <h2 id="niveaux">Trois niveaux de certitude</h2>
        <dl class="legend">
          {levels.map((l) => (
            <div>
              <dt><LevelIcon level={l} size={20} /><span class="lbl">{levelLabel[l]}</span></dt>
              <dd>{legend[l]}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {levels.map((l) => (
      <section class="sec col fact-group" aria-labelledby={`g-${l}`}>
        <div class="sec-inner">
          <h2 id={`g-${l}`}><LevelIcon level={l} size={22} />{groups[l]}</h2>
          <div class="facts">
            {facts.filter((f) => f.level === l).map((f) => (
              <article class={`fact fact--${l}`}>
                <p class="badge"><LevelIcon level={l} size={14} />{levelLabel[l]}</p>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                {f.note && <p class="note"><strong>Note :</strong> {f.note}</p>}
                <Sources ids={f.sources} />
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="sec col" aria-labelledby="chronologie">
      <div class="sec-inner">
        <h2 id="chronologie">Chronologie</h2>
        <ol class="timeline">
          {events.map((e) => (
            <li class={e.level ? `tl--${e.level}` : "tl--fait"}>
              {e.level ? (
                <LevelIcon level={e.level} size={20} />
              ) : (
                <svg class="level-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="4" fill="currentColor" /></svg>
              )}
              <div>
                <p class="t-date">
                  <time class="mono" datetime={e.date}>{e.label}</time>
                  {e.level && <span class="lbl">{levelLabel[e.level]}</span>}
                </p>
                <h3>{e.title}</h3>
                {e.body && <p class="t-body">{e.body}</p>}
                <Sources ids={e.sources} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec col" aria-labelledby="preparer">
      <div class="sec-inner">
        <h2 id="preparer">Que faire en attendant</h2>
        <ol class="prepare">
          {prepare.map((p) => (
            <li>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec col faq" aria-labelledby="faq">
      <div class="sec-inner">
        <h2 id="faq">Questions fréquentes</h2>
        <div>
          {faq.map((f) => (
            <details>
              <summary><h3>{f.q}</h3></summary>
              <p class="answer">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec col" aria-labelledby="methode">
      <div class="sec-inner">
        <h2 id="methode">Méthode</h2>
        <ol class="methodology">
          {methodology.map((m) => <li>{m}</li>)}
        </ol>
      </div>
    </section>

    <section class="sec col" aria-labelledby="historique">
      <div class="sec-inner">
        <h2 id="historique">Historique des mises à jour</h2>
        <ul class="changelog">
          {changelog.map((c) => (
            <li>
              <time class="mono" datetime={c.date}>{formatDate(c.date)}</time>
              <span>{c.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec col" aria-labelledby="sources">
      <div class="sec-inner">
        <h2 id="sources">Sources</h2>
        <ol class="sources">
          {sources.map((s) => (
            <li id={`src-${s.id}`}>
              <p class="s-meta">
                <span class="s-kind">{kindLabel[s.kind]}</span>
                <span>{s.publisher}</span>
                <time class="mono" datetime={s.published}>{formatDate(s.published)}</time>
              </p>
              <a href={s.url} rel="noopener">{s.title}</a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec col about" aria-labelledby="tabaa">
      <div class="sec-inner">
        <h2 id="tabaa">À propos de Tabaa</h2>
        <p>
          Tabaa est un logiciel de facturation libre pour le Maroc, conçu en pensant à cette réforme. Il n'est pas raccordé à la DGI et ne dispose d'aucun agrément : aucun dispositif d'agrément des logiciels de facturation n'a été publié à ce jour.
        </p>
        <p><a href={repo} rel="noopener">Voir le code source sur GitHub</a></p>
        <figure>
          <Image
            src={dashboard}
            alt="Tableau de bord de Tabaa : créances, facturé et encaissé, échéancier."
            width={1040}
            height={650}
            widths={[520, 780, 1040, 1560]}
            sizes="(min-width: 1080px) 680px, calc(100vw - 2rem)"
            fit="cover"
            position="top"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Capture du tableau de bord de Tabaa.</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="col">
      <p><a href={issues} rel="noopener">Signaler une erreur ou une mise à jour</a></p>
      <p>Le logiciel Tabaa est distribué sous licence <a href={`${repo}/blob/main/LICENSE`} rel="noopener">GNU Affero General Public License v3.0</a>.</p>
      <p>Cette page n'est pas un avis juridique ou fiscal.</p>
    </div>
  </footer>
</Base>
