---
import type { Level } from "../data/reforme";
interface Props { level: Level; size?: number }
const { level, size = 18 } = Astro.props;
---

<svg class={`level-icon level-${level}`} viewBox="0 0 20 20" width={size} height={size} aria-hidden="true" focusable="false">
  {level === "en-vigueur" && (
    <>
      <rect x="1.5" y="1.5" width="17" height="17" rx="3" fill="currentColor"></rect>
      <path d="M5.5 10.4l3 3 6-6.4" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </>
  )}
  {level === "annonce" && (
    <>
      <circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M10 1.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
    </>
  )}
  {level === "non-confirme" && (
    <>
      <path d="M10 1.8L18.2 10 10 18.2 1.8 10z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-dasharray="3.2 2.4" stroke-linejoin="round"></path>
      <path d="M8.2 7.9a1.9 1.9 0 1 1 2.6 1.8c-.6.3-.8.7-.8 1.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      <circle cx="10" cy="13.4" r="1" fill="currentColor"></circle>
    </>
  )}
</svg>
